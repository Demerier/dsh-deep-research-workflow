{
  "name": "dsh-deep-research-workflow",
  "version": "0.2.0",
  "description": "Deep-research workflow for DeepSeek Harness: brief -> plan angles -> parallel findings -> reflect -> single-writer cited report -> cold review. A port of MiMo Code's built-in deep-research workflow to DSH plugin form.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "docs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deep-research",
    "workflow",
    "citations",
    "research"
  ],
  "license": "MIT",
  "author": "demerier <demerier@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demerier/dsh-deep-research-workflow.git"
  },
  "homepage": "https://github.com/Demerier/dsh-deep-research-workflow#readme",
  "bugs": {
    "url": "https://github.com/Demerier/dsh-deep-research-workflow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run.mjs"
  }
}